# Operator config for the agent-audit-consulting instance.
#
# Copy this file to .local/config.env and fill in real values.
# .local/ is gitignored repo-wide — real values never enter git.
#
# Alternative: set these as env vars (env vars take precedence over the file).
# In GitHub Actions, set them as repo Secrets with the same names; the deploy
# workflow reads them and renders before publishing.

OPERATOR_EMAIL=you@example.com
STRIPE_CHECKOUT_URL=https://buy.stripe.com/REPLACE_ME
